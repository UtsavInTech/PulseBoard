# Copy this to .env and customise before running docker-compose

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=analytics_db

# MUST be changed in production — minimum 32 characters
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_AT_LEAST_32_CHARS

# Public URL of the backend as seen by the browser
VITE_API_URL=http://localhost:8000

# ─── OpenAI (server-side only — never exposed to the frontend) ───────────────
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4.1
# minimal | low | medium | high — lower is faster
OPENAI_REASONING_EFFORT=low
